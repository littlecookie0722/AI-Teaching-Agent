{
  "version": "0.1.0",
  "phase": "Phase 2",
  "mode": "REAL_LLM_FIRST_CALL_APPROVAL_GATE_ONLY",
  "description": "Real LLM first-call final approval gate. It evaluates local final-approval evidence for a future first real LLM dry-run request, but must not import SDKs, construct clients, check or read secrets, send requests, access network, create generated content, create tasks, or publish content.",
  "supportedProvider": "openai",
  "operation": "generateJson",
  "promptId": "lab_generation_v0",
  "outputKind": "Lab",
  "upstreamGateId": "real_llm_request_review_package",
  "schemaRef": "templates/lab/lab.schema.json",
  "secretEnv": "OPENAI_API_KEY",
  "allowedOperations": [
    "request_review_package_evaluation",
    "approval_checklist_generation",
    "manual_approval_package_model"
  ],
  "blockedOperations": [
    "sdk_import",
    "client_construction",
    "secret_presence_check",
    "secret_value_read",
    "request_send",
    "network_request",
    "real_llm_call",
    "generated_content_creation",
    "task_creation",
    "auto_publish"
  ],
  "rules": {
    "requiresRequestReviewPackageReady": true,
    "requiresExplicitFirstCallApprovalOptIn": true,
    "requiresApproverIdentity": true,
    "requiresApprovalRecord": true,
    "requiresSecretInjectionRuntimeReview": true,
    "requiresNetworkEgressWindowReview": true,
    "requiresCostLimitReview": true,
    "requiresRollbackPlan": true,
    "manualApprovalGranted": false,
    "realCallAuthorized": false,
    "generatedContentDefaultStatus": "WAITING_REVIEW"
  },
  "assertions": {
    "requestReviewPackageReady": true,
    "firstCallApprovalChecklistReady": true,
    "firstCallApprovalGateReady": true,
    "readyForDisabledFirstCallExecutor": true,
    "readyForFirstRealCallApproval": false,
    "manualApprovalPackageMaterialized": false,
    "manualApprovalGranted": false,
    "sdkImported": false,
    "clientCreated": false,
    "secretPresenceChecked": false,
    "secretValueRead": false,
    "secretValueReturned": false,
    "secretValueLogged": false,
    "requestSent": false,
    "networkAccess": false,
    "realLlmCalled": false,
    "generatedContentCreated": false,
    "taskCreated": false,
    "autoPublishAllowed": false,
    "realPublish": false
  }
}
