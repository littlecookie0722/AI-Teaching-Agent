{
  "version": "0.1.0",
  "phase": "Phase 1",
  "targetPhase": "Phase 2",
  "mode": "MOCK_ONLY",
  "id": "provider_runtime_guard_contract",
  "title": "Provider Runtime Guard Contract",
  "description": "Local runtime guard before any future real LLM Provider PoC. It validates timeout, retry, concurrency, schema, review, redaction, and audit requirements without importing SDKs, reading secret values, or performing network calls.",
  "guardId": "provider_runtime_guard",
  "interfaceName": "LLMProvider",
  "activeProvider": "mock",
  "inputs": [
    {
      "id": "provider_runtime_guard",
      "path": "providers/provider_runtime_guard.py",
      "required": true,
      "localOnly": true
    },
    {
      "id": "provider_contract",
      "path": "providers/provider.contract.json",
      "required": true,
      "localOnly": true
    },
    {
      "id": "runtime_contract",
      "path": "config/runtime.contract.json",
      "required": true,
      "localOnly": true
    },
    {
      "id": "real_provider_gate_contract",
      "path": "providers/real-provider-gate.contract.json",
      "required": true,
      "localOnly": true
    },
    {
      "id": "real_provider_shell_contract",
      "path": "providers/real-provider-shell.contract.json",
      "required": true,
      "localOnly": true
    }
  ],
  "guardedOperations": [
    {
      "id": "generateJson",
      "providerIds": ["openai", "anthropic", "local"],
      "promptId": "lab_generation_v0",
      "outputKind": "Lab",
      "enabled": true,
      "performsNetworkCall": false,
      "readsSecretValue": false,
      "createsClient": false,
      "createsTask": false,
      "generatedStatus": "WAITING_REVIEW"
    }
  ],
  "runtimeLimits": {
    "timeoutSeconds": {
      "min": 1,
      "max": 120,
      "default": 30,
      "required": true
    },
    "retryCount": {
      "min": 0,
      "max": 3,
      "default": 1,
      "required": true
    },
    "concurrencyLimit": {
      "min": 1,
      "max": 4,
      "default": 1,
      "required": true
    }
  },
  "redaction": {
    "required": true,
    "redactedValue": "[REDACTED]",
    "sensitiveKeyParts": ["api_key", "apikey", "authorization", "credential", "password", "private_key", "secret", "token"],
    "blockedLeakPatterns": ["sk-", "xoxb-", "AKIA", "Bearer ", "password=", "token=", "secret=", "BEGIN PRIVATE KEY"]
  },
  "requiredContext": {
    "phase": "Phase 1",
    "targetPhase": "Phase 2",
    "mode": "MOCK_ONLY",
    "defaultProvider": "mock",
    "guardPassed": true,
    "timeoutConfigured": true,
    "retryConfigured": true,
    "concurrencyLimitConfigured": true,
    "logRedactionRequired": true,
    "redactionApplied": true,
    "schemaValidationRequired": true,
    "generatedStatus": "WAITING_REVIEW",
    "auditRequired": true,
    "readyForRealProvider": false,
    "secretValueReturned": false,
    "sdkImported": false,
    "clientCreated": false,
    "generatedContentCreated": false,
    "taskCreated": false,
    "reviewBypassed": false,
    "realLlmCalled": false,
    "secretsRead": false,
    "networkAccess": false,
    "autoPublishAllowed": false,
    "realPublish": false
  },
  "errorCodes": [
    "VALIDATION_ERROR",
    "UNSUPPORTED_OPERATION",
    "NOT_FOUND"
  ],
  "blockedOperations": [
    "read_real_secret",
    "log_secret",
    "network_call",
    "sdk_import",
    "client_create",
    "real_provider_generate",
    "bypass_schema",
    "bypass_review",
    "create_task_before_guard",
    "auto_publish"
  ],
  "recommendedCommandIds": [
    "test_provider_runtime_guard",
    "test_real_provider_gate",
    "test_real_provider_shell",
    "test_phase2_provider_plan",
    "test_all"
  ],
  "safety": {
    "manualOnly": true,
    "realLlmCalled": false,
    "realAgentStarted": false,
    "realCloudResourceCreated": false,
    "sandboxExecuted": false,
    "contestantCodeExecuted": false,
    "unknownShellExecuted": false,
    "autoPublishAllowed": false,
    "realPublish": false,
    "remoteUploadAllowed": false,
    "secretVisibleInFrontend": false,
    "secretsRead": false,
    "networkAccess": false
  }
}
