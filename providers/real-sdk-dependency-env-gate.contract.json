      "path": ".env.example",
      "required": true,
      "localOnly": true
    }
  ],
  "entrypoints": [
    {
      "type": "cli",
      "command": "python lab_cli.py provider real-sdk-dependency-env describe",
      "expectedCode": "OK"
    },
    {
      "type": "cli",
      "command": "python lab_cli.py provider real-sdk-dependency-env check --provider openai",
      "expectedCode": "OK",
      "expectedSignal": "dependencyEnvChecklistPassed=false"
    },
    {
      "type": "cli",
      "command": "python lab_cli.py provider real-sdk-dependency-env check --provider openai --approval-ref APPROVAL-001 --reviewer teacher_1 --confirm-dry-run-plan --confirm-runtime-guard --confirm-schema-review --confirm-human-review-policy --confirm-audit-redaction --confirm-sdk-dependency-review --confirm-provider-contract-review --confirm-runtime-contract-review --confirm-secret-injection-review --confirm-network-access-review --confirm-rollback-plan --confirm-minimal-impl-review --confirm-sdk-package-review --confirm-sdk-version-pin-review --confirm-dependency-license-review --confirm-dependency-hash-review --confirm-env-var-name-review --confirm-env-example-review --confirm-secret-non-read-policy --confirm-ci-install-policy",
      "expectedCode": "OK",
      "expectedSignal": "readyForDependencyImplementationTask=true"
    }
  ],
