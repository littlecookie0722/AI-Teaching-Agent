  "providerPrinciples": [
    {
      "id": "mock_provider_first",
      "required": true,
      "description": "MockProvider remains the default implementation and acceptance path."
    },
    {
      "id": "real_provider_requires_explicit_task",
      "required": true,
      "description": "OpenAI, Anthropic, or local model providers require a separate approved task before implementation."
    },
    {
      "id": "schema_validation_required",
      "required": true,
      "description": "generateJson output must validate against the declared DSL schema before creating an AI Task."
    },
    {
      "id": "safe_error_matrix_required",
      "required": true,
      "description": "Provider Adapter error paths must return safe mock-only context without creating tasks or generated content."
    },
    {
      "id": "provider_call_audit_required",
      "required": true,
      "description": "Provider registry, health, and generateJson success or failure paths must write local mock audit events."
    },
    {
      "id": "prompt_manifest_only",
      "required": true,
      "description": "Business code references prompt ids and the prompt manifest instead of embedding prompts inline."
    },
    {
      "id": "secrets_from_env_only",
      "required": true,
      "description": "Secrets and endpoints come from runtime configuration or environment variables only."
    },
    {
      "id": "logs_redact_secrets",
      "required": true,
      "description": "Provider logs must redact secrets, tokens, candidate-hidden answers, and raw credentials."
    },
    {
      "id": "timeouts_retries_configured",
      "required": true,
      "description": "Timeout, retry, and concurrency limits must be configured before any real provider is enabled."
    },
    {
      "id": "network_disabled_until_enabled",
      "required": true,
      "description": "Network access remains disabled until a future explicit provider task changes the runtime gate."
    },
    {
      "id": "review_gate_required",
      "required": true,
      "description": "Generated Lab, Exam, Grading, and PPT DSL output defaults to WAITING_REVIEW."
    },
    {
      "id": "real_provider_preflight_gate",
      "required": true,
      "description": "Real Provider PoC must pass a disabled-by-default local preflight gate before any implementation can route to a real SDK."
    },
    {
      "id": "real_provider_shell_disabled",
      "required": true,
      "description": "OpenAI, Anthropic, and local model provider classes may exist only as disabled shells until a future real provider task enables routing."
    },
    {
      "id": "provider_runtime_guard_required",
      "required": true,
      "description": "Timeout, retry, concurrency, redaction, schema, audit, and review guards must pass locally before any future real provider call."
    },
    {
      "id": "real_llm_poc_adapter_disabled",
      "required": true,
      "description": "Real LLM PoC adapter may wire runtime guard and preflight only while keeping SDK calls, generated content, AI task creation, and publish disabled."
    },
    {
      "id": "real_llm_dry_run_plan_required",
      "required": true,
      "description": "A local dry-run plan must pass for the first Lab DSL scope before any future real LLM call is enabled."
    },
    {
      "id": "real_llm_approval_gate_required",
      "required": true,
      "description": "A local pre-implementation approval gate must pass before any future task may change runtime/provider contracts for real LLM SDK work."
    },
    {
      "id": "real_llm_sdk_task_blueprint_required",
      "required": true,
      "description": "A local implementation blueprint must define future SDK scope, proposed changes, tests, rollback, and blocking conditions before any real SDK code task starts."
    },
    {
      "id": "real_provider_sdk_poc_disabled",
      "required": true,
      "description": "A default-disabled SDK PoC harness may require the blueprint before reaching the disabled adapter, but it must still block SDK imports, secret checks, network calls, generated content, and AI task creation."
    },
    {
      "id": "real_sdk_enablement_switch_required",
      "required": true,
      "description": "A final enablement switch design gate must pass before any future task may review runtime/provider contract changes for real SDK work."
    },
    {
      "id": "real_sdk_minimal_impl_disabled",
      "required": true,
      "description": "A first implementation-shaped SDK shell may exist only when it remains default-disabled and blocks SDK imports, secret checks, network calls, generated content, and AI task creation."
    },
    {
      "id": "real_sdk_dependency_env_gate_required",
      "required": true,
      "description": "Real SDK dependency and environment-variable changes require a separate design-only gate before any dependency installation or secret presence check."
    },
    {
      "id": "real_sdk_dependency_install_plan_required",
      "required": true,
      "description": "Real SDK dependency installation requires a draft-only install plan review before any future package install, version resolution, hash verification, or lockfile change."
    },
    {
      "id": "real_sdk_dependency_installer_audit_required",
      "required": true,
      "description": "A disabled installer audit must pass before any future SDK dependency installation implementation task can materialize commands or file changes."
    }
  ],
  "interfaceDesign": {
    "interfaceName": "LLMProvider",
    "methods": [
      {
        "name": "generateText",
        "returns": "ProviderResult",
        "requiresSchemaValidation": false
      },
      {
        "name": "generateJson",
        "returns": "ProviderJsonResult",
        "requiresSchemaValidation": true
      },
      {
        "name": "streamGenerate",
        "returns": "ProviderStreamResult",
        "requiresSchemaValidation": false,
        "deferred": true
      }
    ],
    "resultFields": [
      "providerId",
      "mode",
      "promptId",
      "promptVersion",
      "generatedStatus",
      "realLlmCalled",
      "secretsRead",
      "networkAccess",
      "traceId"
    ]
  },
