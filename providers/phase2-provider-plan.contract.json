    },
    {
      "id": "define_real_llm_dry_run_plan",
      "allowed": true,
      "description": "Define a local real LLM dry-run plan that checks scope and runtime guards while keeping SDK imports, secret reads, network calls, generated content, and AI task creation disabled."
    },
    {
      "id": "define_real_llm_approval_gate",
      "allowed": true,
      "description": "Define a local approval checklist gate before real SDK implementation while keeping real calls unauthorized."
    },
    {
      "id": "define_real_llm_sdk_task_blueprint",
      "allowed": true,
      "description": "Define a local blueprint for a future minimal real LLM SDK implementation task while keeping SDK dependencies, contract changes, secret checks, network calls, generated content, and AI task creation disabled."
    },
    {
      "id": "define_real_provider_sdk_poc_harness",
      "allowed": true,
      "description": "Define a default-disabled SDK PoC harness that composes the task blueprint and disabled adapter without installing SDKs, checking secrets, opening network, generating content, or creating AI tasks."
    },
    {
      "id": "define_real_sdk_enablement_switch",
      "allowed": true,
      "description": "Define the final local enablement switch checklist without applying runtime/provider contract changes, installing SDKs, checking secrets, opening network, or authorizing real calls."
    },
    {
      "id": "define_real_sdk_minimal_impl_shell",
      "allowed": true,
      "description": "Define a default-disabled real SDK minimal implementation shell after enablement without installing SDKs, importing SDKs, checking secrets, opening network, generating content, or creating AI tasks."
    },
    {
      "id": "define_real_sdk_dependency_env_gate",
      "allowed": true,
      "description": "Define a design-only dependency and environment gate without installing SDKs, resolving package versions, checking secret presence, reading secrets, opening network, generating content, or creating AI tasks."
    },
    {
      "id": "define_real_sdk_dependency_install_plan",
      "allowed": true,
      "description": "Define a draft-only dependency install plan without generating install commands, installing SDKs, resolving package versions or hashes, modifying lockfiles, checking secrets, opening network, generating content, or creating AI tasks."
    },
    {
      "id": "define_real_sdk_dependency_installer_audit",
      "allowed": true,
      "description": "Define a disabled installer audit shell without generating executable commands, installing dependencies, resolving packages, modifying files, checking secrets, opening network, or creating AI tasks."
    }
  ],
