{
  "version": "0.1.0",
  "phase": "Phase 1",
  "mode": "MOCK_ONLY",
  "description": "Reusable skill registry for Phase 1 operations. Skills point to prompt files, DSL schemas, workflow contracts, and CLI commands.",
  "globalRules": {
    "realLlmCalled": false,
    "realCloudResourceCreated": false,
    "contestantCodeExecuted": false,
    "outputMustBeDsl": true,
    "generatedContentDefaultStatus": "WAITING_REVIEW",
    "publishBlockedUntilApproved": true
  },
  "skills": [
    {
      "id": "lab-generation",
      "name": "Lab Generation",
      "path": "skills/lab-generation/SKILL.md",
      "promptId": "lab_generation_v0",
      "promptPath": "prompts/workflows/lab_generation.md",
      "workflowId": "lab_generation_mock",
      "outputKind": "Lab",
      "outputSchema": "templates/lab/lab.schema.json",
      "exampleOutput": "templates/lab/examples/basic-lab.yaml",
      "cli": "python lab_cli.py lab generate-from-source --input <input>",
      "reviewRequired": true,
      "mode": "MOCK_ONLY"
    },
    {
      "id": "exam-generation",
      "name": "Exam Generation",
      "path": "skills/exam-generation/SKILL.md",
      "promptId": "exam_generation_v0",
      "promptPath": "prompts/workflows/exam_generation.md",
      "workflowId": "exam_generation_mock",
      "outputKind": "Exam",
      "outputSchema": "templates/exam/exam.schema.json",
      "exampleOutput": "templates/exam/examples/notebook-fill-blank.yaml",
      "cli": "python lab_cli.py exam generate-from-lab --lab-id <labId>",
      "reviewRequired": true,
      "answerVisibleToCandidate": false,
      "mode": "MOCK_ONLY"
    },
    {
      "id": "grading-script-generation",
      "name": "Grading Script Generation",
      "path": "skills/grading-script-generation/SKILL.md",
      "promptId": "grading_generation_v0",
      "promptPath": "prompts/workflows/grading_generation.md",
      "workflowId": "exam_generation_mock",
      "outputKind": "Grading",
      "outputSchema": "templates/grading/grading.schema.json",
      "exampleOutput": "templates/grading/examples/python-pytest.yaml",
      "cli": "python lab_cli.py grade run --grading <grading>",
      "reviewRequired": true,
      "sandboxRequiredBeforeRealExecution": true,
      "mode": "MOCK_ONLY"
    },
    {
      "id": "ppt-generation",
      "name": "PPT Generation",
      "path": "skills/ppt-generation/SKILL.md",
      "promptId": "ppt_generation_v0",
      "promptPath": "prompts/workflows/ppt_generation.md",
      "workflowId": "ppt_generation_mock",
      "outputKind": "PPT",
      "outputSchema": "templates/ppt/ppt.schema.json",
      "exampleOutput": "templates/ppt/examples/course-ppt.yaml",
      "cli": "python lab_cli.py ppt generate --input <input>",
      "reviewRequired": true,
      "artifactGenerated": false,
      "mode": "MOCK_ONLY"
    },
    {
      "id": "operations-skill-pack",
      "name": "Operations Skill Pack",
      "path": "skills/operations-skill-pack/SKILL.md",
      "contractPath": "skills/operations-skill-pack.contract.json",
      "baseSkillIds": [
        "lab-generation",
        "exam-generation",
        "grading-script-generation",
        "ppt-generation"
      ],
      "outputKind": "OperationSkillPack",
      "cli": "python -m pytest tests/test_operations_skill_pack.py",
      "reviewRequired": true,
      "mode": "MOCK_ONLY",
      "realAgentStarted": false,
      "realLlmCalled": false,
      "publishBlockedUntilApproved": true
    }
  ]
}
