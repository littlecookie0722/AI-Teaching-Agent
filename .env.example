# Phase 1 local mock defaults.
# Copy to .env only for local development; never commit real .env files.

APP_PHASE=Phase 1
APP_MODE=MOCK_ONLY

# Local mock store. Leave empty to use cli/.lab_cli_store.json.
LAB_CLI_STORE=

# Real providers are disabled in Phase 1.
ENABLE_REAL_LLM=false
ENABLE_REAL_PROVIDER_PREFLIGHT=false
ENABLE_REAL_CLOUD=false
ENABLE_REAL_SANDBOX=false
ENABLE_AUTO_PUBLISH=false

# Real LLM SDK boundary checks. These do not authorize real model calls.
ENABLE_REAL_LLM_SDK_BOUNDARY=false
ENABLE_REAL_LLM_SDK_CLIENT_BOUNDARY=false
ENABLE_REAL_LLM_REQUEST_REVIEW_PACKAGE=false
ENABLE_REAL_LLM_FIRST_CALL_APPROVAL_GATE=false
ENABLE_REAL_LLM_FIRST_CALL_EXECUTOR_DISABLED=false
ENABLE_REAL_LLM_PRE_SEND_DRY_RUN_RECORD=false
ENABLE_REAL_LLM_MINIMAL_CALL_POC_REVIEW=false
ENABLE_REAL_LLM_MINIMAL_CALL_SEND_EXECUTOR_DISABLED=false
ENABLE_REAL_LLM_REQUEST_SEND_AUTHORIZATION_PACKAGE=false
ENABLE_REAL_LLM_REQUEST_SEND_EXECUTION_REQUEST_DISABLED=false
ENABLE_REAL_LLM_REQUEST_SEND_EXECUTOR_DISABLED=false
ENABLE_REAL_LLM_REQUEST_SEND_FINAL_APPROVAL_REVIEW=false
ENABLE_REAL_LLM_REQUEST_SEND_AUTHORIZATION_TASK_DISABLED=false
ENABLE_REAL_LLM_REQUEST_SEND_AUTHORIZATION_RECORD_WRITE_GATE=false
ENABLE_REAL_LLM_REQUEST_SEND_RUNTIME_GATE_DISABLED=false
ENABLE_REAL_LLM_REQUEST_SEND_EXECUTOR_CREATION_GATE_DISABLED=false
ENABLE_REAL_LLM_REQUEST_SEND_EXECUTOR_DISPATCH_GATE_DISABLED=false
ENABLE_REAL_LLM_REQUEST_SEND_ATTEMPT_GATE_DISABLED=false
REAL_LLM_DRY_RUN_ONLY=true

# Placeholder variable names only. Do not put real secrets in this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_MODEL_ENDPOINT=
CLOUD_PROVIDER_TOKEN=
DATABASE_URL=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Optional real LLM online smoke. Leave disabled for normal local/CI regression.
# When enabled, the test may send a real OpenAI-compatible request.
LAB_REAL_LLM_ONLINE_SMOKE=0
LAB_REAL_LLM_ONLINE_SMOKE_MODEL=
LAB_REAL_LLM_ONLINE_SMOKE_BASE_URL=
LAB_REAL_LLM_ONLINE_SMOKE_API_SURFACE=chat.completions
LAB_REAL_LLM_ONLINE_SMOKE_MAX_OUTPUT_TOKENS=1200
LAB_REAL_LLM_ONLINE_SMOKE_TIMEOUT_SECONDS=60

# Real agent draft import PoC. Leave empty unless explicitly testing real agent API calls.
AGENT_API_BASE_URL=
AGENT_API_TOKEN=

# Backend Core API local/staging knobs. Leave secret values empty here.
LAB_BACKEND_API_TOKEN=
LAB_BACKEND_CORE_DATABASE_URL=
LAB_BACKEND_CORE_REPOSITORY_KIND=
LAB_BACKEND_GRADING_DB_PATH=
LAB_BACKEND_CORE_POSTGRESQL_SMOKE=
LAB_BACKEND_CORE_POSTGRESQL_SMOKE_REVIEWER=

# Frontend / API placeholders for future phases.
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
