{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grading DSL",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "metadata",
    "status",
    "spec"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "kind": {
      "const": "Grading"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sourceExamId": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "WAITING_REVIEW",
        "APPROVED",
        "REJECTED"
      ]
    },
    "spec": {
      "type": "object",
      "required": [
        "totalScore",
        "checks"
      ],
      "properties": {
        "totalScore": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "assessmentPlan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "checkId",
              "type",
              "runner",
              "score",
              "inputSummary",
              "executionPlan",
              "mockEvidence",
              "riskLevel",
              "sandboxRequiredBeforeRealExecution"
            ],
            "properties": {
              "checkId": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "file_exists",
                  "stdout_contains",
                  "pytest",
                  "notebook_cell",
                  "json_field",
                  "log_keyword"
                ]
              },
              "runner": {
                "type": "string"
              },
              "score": {
                "type": "integer",
                "minimum": 1
              },
              "inputSummary": {
                "type": "string",
                "minLength": 1
              },
              "executionPlan": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "strategy",
                  "requiredLimits",
                  "wouldRunInsideRealSandbox"
                ],
                "properties": {
                  "strategy": {
                    "const": "MOCK_PLAN_ONLY"
                  },
                  "requiredLimits": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cpu",
                      "memory",
                      "timeout",
                      "network",
                      "filesystem",
                      "process"
                    ],
                    "properties": {
                      "cpu": {
                        "type": "string"
                      },
                      "memory": {
                        "type": "string"
                      },
                      "timeout": {
                        "type": "string"
                      },
                      "network": {
                        "const": "disabled_by_default"
                      },
                      "filesystem": {
                        "type": "string"
                      },
                      "process": {
                        "type": "string"
                      }
                    }
                  },
                  "wouldRunInsideRealSandbox": {
                    "const": true
                  }
                }
              },
              "mockEvidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "MOCK_EVIDENCE_NOT_COLLECTED"
                  }
                }
              },
              "riskLevel": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "sandboxRequiredBeforeRealExecution": {
                "const": true
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "score"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "file_exists",
                  "stdout_contains",
                  "pytest",
                  "notebook_cell",
                  "json_field",
                  "log_keyword"
                ]
              },
              "path": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "notebookPath": {
                "type": "string"
              },
              "cellIndex": {
                "type": "integer",
                "minimum": 0
              },
              "jsonPath": {
                "type": "string"
              },
              "expectedValue": {},
              "expected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "score": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
