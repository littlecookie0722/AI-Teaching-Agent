{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lab DSL",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "metadata",
    "status",
    "spec"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "kind": {
      "const": "Lab"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "difficulty",
        "durationMinutes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ]
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "WAITING_REVIEW",
        "APPROVED",
        "REJECTED",
        "PUBLISHED"
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectives",
        "targetUsers",
        "environment",
        "steps"
      ],
      "properties": {
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "targetUsers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "image"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "image": {
              "type": "string"
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "integer",
                  "minimum": 1
                },
                "memoryGb": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "instruction"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "instruction": {
                "type": "string"
              },
              "commands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expectedResult": {
                "type": "string"
              }
            }
          }
        },
        "grading": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
