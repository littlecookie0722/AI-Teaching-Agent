{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT DSL",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "metadata",
    "status",
    "spec"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "kind": {
      "const": "PPT"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "audience",
        "durationMinutes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "WAITING_REVIEW",
        "APPROVED",
        "REJECTED"
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "slides"
      ],
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "style",
            "language"
          ],
          "properties": {
            "style": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          }
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "title",
                  "content",
                  "summary"
                ]
              },
              "title": {
                "type": "string"
              },
              "subtitle": {
                "type": "string"
              },
              "bullets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
