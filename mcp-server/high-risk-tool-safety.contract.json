      "name": "publish_lab",
      "riskLevel": "high",
      "toolCategory": "high_risk_review_intent",
      "backend": {
        "method": "POST",
        "path": "/api/mcp/intents/publish-lab"
      },
      "reviewRequired": true,
      "createsAiTask": true,
      "createdTaskType": "MCP_PUBLISH_LAB_INTENT",
      "createdTaskStatus": "WAITING_REVIEW",
      "reviewIntentOnly": true,
      "readOnly": false,
      "requiresSecondConfirmation": false,
      "allowedPostReviewDispositionStates": [
        "WAITING_HUMAN_REVIEW",
        "APPROVED_EXECUTION_BLOCKED"
      ],
      "blockedActions": [
        "executeRealAction",
        "executeRealPublish",
        "autoPublish",
        "bypassHumanReview"
      ],
      "expectedManifestSafety": {
        "mode": "MOCK_ONLY",
        "defaultGeneratedStatus": "WAITING_REVIEW",
        "reviewIntentOnly": true,
        "publishBlockedUntilApproved": true,
        "requiresSecondConfirmation": false,
        "autoPublishAllowed": false,
        "realPublish": false,
        "realActionExecuted": false
      },
      "expectedRuntimeSafety": {
        "realMcpServerStarted": false,
        "realAgentStarted": false,
        "realLlmCalled": false,
        "networkAccess": false,
        "realCloudResourceChanged": false,
        "sandboxExecuted": false,
        "contestantCodeExecuted": false,
        "autoPublishAllowed": false,
        "realPublish": false,
        "realActionExecuted": false
      },
      "frontendEvidence": {
        "highRiskIntentItem": true,
        "mcpToolCallRecordId": "mcp_call_publish_lab_intent_demo",
        "expectedMockDisposition": "WAITING_HUMAN_REVIEW"
