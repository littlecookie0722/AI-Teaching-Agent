          "required": true
        },
        "lab.category": "payload.category",
        "lab.difficulty": "payload.difficulty",
        "lab.durationMinutes": "payload.durationMinutes",
        "lab.tags": {
          "source": "payload.tags",
          "default": []
        },
        "lab.objectiveTotal": "payload.objectiveTotal",
        "lab.stepTotal": "payload.stepTotal",
        "lab.materialTotal": "payload.materialTotal",
        "lab.environment.type": "payload.environment.type",
        "lab.environment.image": "payload.environment.image",
        "lab.environment.resources": {
          "source": "payload.environment.resources",
          "default": {}
        },
        "lab.gradingRef": "payload.gradingRef"
      }
    },
    "exam_question": {
