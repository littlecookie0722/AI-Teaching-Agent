        "exam.answerStoragePolicy": "payload.answerStoragePolicy",
        "exam.candidateAnswerVisible": {
          "source": "payload.candidateAnswerVisible",
          "default": false
        }
      }
    },
    "grading_rule": {
      "draftImportPath": "/open/staging/grading-rule-draft-imports",
      "statusPathTemplate": "/open/staging/grading-rule-draft-imports/{agentDraftId}/state",
