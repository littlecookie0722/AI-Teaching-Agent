{
  "statusPathTemplate": "/open/staging/draft-imports/{draftImportId}/state",
  "draftIdResponseKeys": [
    "draftImportId",
    "draftId",
    "id"
  ],
  "statusResponseKeys": [
    "agentStatus",
    "status",
    "state"
  ],
  "statusMapping": {
    "QUEUED": "PENDING_MANUAL_PLATFORM_REVIEW",
    "WAITING_REVIEW": "PENDING_MANUAL_PLATFORM_REVIEW",
    "IN_REVIEW": "PENDING_MANUAL_PLATFORM_REVIEW",
    "DONE": "ACCEPTED_FOR_DRAFT",
    "ACCEPTED": "ACCEPTED_FOR_DRAFT",
    "REJECTED": "REJECTED_BY_PLATFORM",
    "FAILED": "FAILED"
  },
  "requestBodyMapping": {
    "workflow.idempotencyKey": "idempotencyKey",
    "workflow.operation": "operation",
    "source.agentEntityId": {
      "source": "source.agentEntityId",
      "required": true
    },
    "source.sourceTaskId": {
      "source": "source.sourceTaskId",
      "required": true
    },
    "source.sourcePreviewArtifactId": "source.sourcePreviewArtifactId",
    "source.sourceArtifactKind": "source.sourceArtifactKind",
    "source.sourceDslPath": "source.sourceDslPath",
