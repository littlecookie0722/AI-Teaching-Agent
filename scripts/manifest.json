      "writesToWorkspace": true,
      "allowedWritePaths": [
        "examples/output/phase1-delivery-package.json"
      ],
      "requiresNetwork": false
    },
    {
      "id": "phase1_report",
      "description": "Render Phase 1 local mock acceptance report from the delivery package.",
