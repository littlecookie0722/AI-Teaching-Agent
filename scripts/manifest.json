{
  "version": "0.1.0",
  "phase": "Phase 1",
  "mode": "MOCK_ONLY",
  "description": "Script safety contract for local Phase 1 validation commands. This manifest does not define destructive or production scripts.",
  "executionPolicy": {
    "allowedWorkingDirectory": "project_root",
    "requiresHumanInitiatedRun": true,
    "unknownShellScriptsAllowed": false,
    "destructiveCommandsAllowed": false,
    "productionAccessAllowed": false,
    "cloudAccessAllowed": false,
    "contestantCodeExecutionAllowed": false,
    "secretLoggingAllowed": false
  },
