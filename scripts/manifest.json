      "id": "phase1_check",
      "description": "Run Phase 1 CLI self-check.",
      "command": "python lab_cli.py phase1 check",
      "category": "validation",
      "writesToWorkspace": false,
      "requiresNetwork": false
    },
    {
      "id": "phase1_export",
      "description": "Export Phase 1 local mock delivery package.",
      "command": "python lab_cli.py phase1 export --output examples/output/phase1-delivery-package.json",
