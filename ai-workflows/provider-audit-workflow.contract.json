    {
      "id": "provider_audit_model",
      "path": "cli/provider_audit.py",
      "required": true,
      "localOnly": true
    },
    {
      "id": "cli_mock",
      "path": "cli/lab_cli.py",
      "required": true,
      "localOnly": true
    },
    {
      "id": "backend_mock_api",
      "path": "backend/mock_api.py",
      "required": true,
      "localOnly": true
    }
  ],
  "auditedWorkflowSteps": [
    {
      "kind": "lab",
      "stepName": "generate_lab_dsl",
      "promptId": "lab_generation_v0",
      "outputKind": "Lab"
    },
    {
